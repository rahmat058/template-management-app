NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Number of proxies in front of the API. Set to 1 when deployed behind a single
# load balancer/ingress, otherwise rate limiting sees the proxy's IP for every client.
TRUST_PROXY=0
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.joojncv.mongodb.net/template_management?retryWrites=true&w=majority
